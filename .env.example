# ==============================================================================
# doingdrop — Supabase Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In local development without external credentials, doingdrop automatically uses
# in-process WebAssembly PostgreSQL (PGlite) and local storage driver.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# 1. Project URL and Public Anon Key (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# 2. Privileged Service Role Key (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 3. Supabase Storage Bucket (Private bucket name)
SUPABASE_STORAGE_BUCKET="doingdrop-files"

# 4. Storage Driver: 'supabase' (for Supabase Storage) or 'local' (offline dev fallback)
STORAGE_DRIVER="supabase"

# 5. Direct Supabase PostgreSQL Connection String (for Drizzle ORM / migrations)
# From Supabase Dashboard > Settings > Database > Connection String (URI, Mode: Session or Transaction)
# Example: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# Cryptographic & Cleanup Secrets
# ------------------------------------------------------------------------------
# Minimum 32-character random string used for HMAC-SHA256 token and code hashing
HASH_SECRET="replace-with-a-cryptographically-secure-random-32-byte-secret"

# Secret used to authenticate scheduled cleanup cron invocations
CLEANUP_SECRET="replace-with-a-secure-cron-authentication-secret"

# ------------------------------------------------------------------------------
# Application Limits & Retention Policies
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=100
MAX_TOTAL_SIZE_MB=500
MAX_FILES_COUNT=20
DEFAULT_EXPIRY_SECONDS=86400    # 24 Hours default
MIN_EXPIRY_SECONDS=300          # 5 Minutes minimum
MAX_EXPIRY_SECONDS=604800       # 7 Days maximum
