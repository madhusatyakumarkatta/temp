# ==============================================================================
# TempDrop — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In local development without external credentials, TempDrop automatically uses
# in-process WebAssembly PostgreSQL (PGlite) and local storage.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL)
# For production (Neon, Supabase, AWS RDS, Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/tempdrop?sslmode=require"
DATABASE_URL=""

# Storage Driver Selection: 'local' (default without credentials) or 'r2'
STORAGE_DRIVER="local"

# Cloudflare R2 / S3-Compatible Storage Configuration
# Required when STORAGE_DRIVER="r2"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="tempdrop-files"
# Optional custom domain for public assets (keep empty for private buckets)
R2_PUBLIC_URL=""

# Cryptographic Salt / Pepper Secrets (Must be at least 32 characters in production)
# NEVER commit or expose real secrets to client-side code!
HASH_SECRET="replace-with-a-cryptographically-secure-random-32-byte-secret"

# Scheduled Cleanup Worker Authentication Secret
# Used to authenticate cron invocations: POST /api/cron/cleanup
CLEANUP_SECRET="replace-with-a-secure-cron-authentication-secret"

# Application Limits & Durations
MAX_FILE_SIZE_MB=100
MAX_TOTAL_SIZE_MB=500
MAX_FILES_COUNT=20
DEFAULT_EXPIRY_SECONDS=86400    # 24 Hours default
MIN_EXPIRY_SECONDS=300          # 5 Minutes minimum
MAX_EXPIRY_SECONDS=604800       # 7 Days maximum
